# HumanHP environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing secrets.

# --- Required for Phase 1 (Supabase Auth) ---
# Project URL from Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon (public) key from Supabase: Project Settings → API
# Safe to expose in the browser only because Row Level Security must protect data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server-only (not used in Phase 1) ---
# Service role key bypasses RLS. Never prefix with NEXT_PUBLIC_. Never send to the client.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Phase 5 (Health Check AI) — not used yet ---
# OPENAI_API_KEY=
# AI_PROVIDER=openai
# OPENAI_MODEL=gpt-4o
